PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/credit_dost_diwali

# Spots
TOTAL_SPOTS_PARTNER=100
TOTAL_SPOTS_CUSTOMER=100
SPOT_COUNT_MODE=submitted
PENDING_EXPIRY_MINUTES=1440
OFFER_END_ISO=2026-11-15T23:59:59+05:30

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys for testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks. Subscribe to: payment.captured, payment.authorized, payment.failed, order.paid, payment_link.paid
RAZORPAY_WEBHOOK_SECRET=

# Admin
ADMIN_TOKEN=
ADMIN_EMAIL=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google Sheets admin sync (Apps Script web app, see scripts/google-sheets-sync.gs)
# Leave empty to disable. Secret must match the SYNC_SECRET script property.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
